---
interface Props {
  text: string
  /** Shown before the text, not copied. */
  prompt?: string
  /** Wrap long text instead of scrolling it. */
  wrap?: boolean
}

const { text, prompt = '$', wrap = false } = Astro.props
---

<div class:list={['copy-line', { wrap }]}>
  <span class="prompt" aria-hidden="true">{prompt}</span>
  <code>{text}</code>
  <button type="button" data-copy={text} aria-label="Copy to clipboard">Copy</button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-line [data-copy]')) {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy!)
      button.textContent = 'Copied'
      setTimeout(() => (button.textContent = 'Copy'), 1500)
    })
  }
</script>

<style>
  .copy-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.7rem 0.7rem 0.7rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.4rem;
    background: color-mix(in oklch, var(--sl-color-black) 60%, transparent);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
  }
  .prompt {
    color: var(--sl-color-accent);
    user-select: none;
  }
  code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    color: var(--sl-color-gray-1);
  }
  .wrap {
    align-items: start;
  }
  .wrap code {
    white-space: normal;
    line-height: 1.6;
  }
  button {
    all: unset;
    cursor: pointer;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  button:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
</style>
