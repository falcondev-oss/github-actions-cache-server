---
// A job log replayed line by line: what a restore from the cache server looks like.
const lines = [
  { kind: 'step', text: 'Run actions/setup-node@v6' },
  { kind: 'out', text: 'Cache restored from key: node-cache-Linux-x64-npm-9f2c41e7' },
  { kind: 'out', text: 'Received 1.18 GiB in 0.15 s', note: '7.9 GiB/s' },
  { kind: 'step', text: 'Run actions/cache@v4' },
  { kind: 'out', text: 'Cache hit for: cargo-registry-3b1d0a', note: 'p99 7 ms' },
  { kind: 'step', text: 'Run docker/build-push-action@v6' },
  { kind: 'out', text: 'importing cache manifest from gha:9c0e2f' },
  { kind: 'out', text: 'CACHED [build 4/9] RUN cargo build --release' },
  { kind: 'done', text: 'Job succeeded in 41 s on a fresh ephemeral runner' },
] as const
---

<figure class="terminal" aria-label="Job log of a cache restore">
  <div class="bar">
    <span></span><span></span><span></span>
    <p>ci / test <b>· runner ephemeral-7f3k</b></p>
  </div>
  <ol>
    {
      lines.map((line, index) => (
        <li class={line.kind} style={`--i: ${index}`}>
          <span>{line.text}</span>
          {'note' in line && <em>{line.note}</em>}
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .terminal {
    min-width: 0;
    margin: 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.6rem;
    background: color-mix(in oklch, var(--sl-color-black) 88%, var(--sl-color-accent) 2%);
    box-shadow:
      0 0 0 1px oklch(0% 0 0 / 0.2),
      0 30px 80px -20px color-mix(in oklch, var(--sl-color-accent) 30%, transparent);
    overflow: hidden;
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .bar span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--sl-color-gray-5);
  }
  .bar p {
    margin: 0 0 0 0.75rem;
    color: var(--sl-color-gray-2);
  }
  .bar b {
    font-weight: 400;
    color: var(--sl-color-gray-4);
  }
  ol {
    margin: 0;
    padding: 1rem 1.1rem 1.2rem;
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.3rem;
    min-height: 17rem;
  }
  li {
    display: flex;
    gap: 1rem;
    white-space: nowrap;
    color: var(--sl-color-gray-3);
    animation: appear 0.35s calc(0.25s + var(--i) * 0.32s) both;
  }
  li.step {
    margin-top: 0.55rem;
    color: var(--sl-color-gray-1);
  }
  li.step:first-child {
    margin-top: 0;
  }
  li span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  li.step span::before {
    content: '▸ ';
    color: var(--sl-color-accent);
  }
  li.out {
    padding-left: 1.1rem;
  }
  li.done {
    margin-top: 0.8rem;
    color: oklch(78% 0.15 150);
  }
  li.done span::before {
    content: '✓ ';
  }
  em {
    flex-shrink: 0;
    margin-left: auto;
    font-style: normal;
    color: var(--sl-color-accent-high);
  }

  @keyframes appear {
    from {
      opacity: 0;
      transform: translateY(0.3rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    li {
      animation: none;
    }
  }
</style>
